# Server Port (Standalone backend defaults to 8080; hosting platforms set PORT automatically)
PORT=8080

# Allowed CORS origin(s) for decoupled web, admin, or mobile clients (* allows all origins)
CORS_ORIGIN=*

# Set to 'true' only if hosting the admin/ static folder from the backend server
SERVE_ADMIN=false

# Server-Side API Keys (Keep secret — set in hosting dashboard or local backend/.env)
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=

# Cryptographic Vault & Security Grid Secrets (Use strong 32+ char random strings in production)
FISM_SECURITY_SECRET=
FISM_VAULT_SECRET=

# Admin Panel Passcode & Contact (If FISM_ADMIN_PASSCODE is empty, first-run Admin setup claims a scrypt-hashed passcode)
FISM_ADMIN_PASSCODE=
FISM_ADMIN_PHONE=
FISM_ADMIN_EMAIL=

# AdsTerra Monetization is configured directly inside the App / Admin Panel (/admin/ -> AdsTerra & Ads), no .env keys needed.

